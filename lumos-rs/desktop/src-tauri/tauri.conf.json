{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumos",
  "version": "0.3.0",
  "identifier": "app.lumos.console",
  "build": {},
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Video",
    "shortDescription": "Control de iluminación escénica",
    "longDescription": "Lumos: consola de iluminación teatral con motor DMX, visualizador 3D/2D y consola virtual.",
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libasound2"] } },
    "windows": { "nsis": { "languages": ["Spanish", "English"], "installMode": "currentUser" }, "wix": { "language": "es-ES" } },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
